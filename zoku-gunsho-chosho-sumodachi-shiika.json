 "blocks": [
  {
   "id": "zoku-gunsho-chosho-sumodachi-shiika-0001",
   "pid": "nao-734213",
   "pages": [
    2
   ],
   "text": "一続羣書類従巻第四百二十二0和歌部五十五二丁長承二年相撲立詩歌合三十六番相撲立詩歌合和漢名所詩歌合総検校保己一集男源忠宝校",
   "poems": []
  },
  {
   "id": "zoku-gunsho-chosho-sumodachi-shiika-0002",
   "pid": "nao-734213",
   "pages": [
    3
   ],
   "text": "同東島津波村長承二年相撲立詩歌古手番右山家春四條大納言春きてそ人もとひける山さとは花こそ宿のあるしなりけれ左元日大極殿前陪従儀同三司玉辰日臨文鳳見紅旗風巻昼龍揚二番右堀川院行幸歌好忠みな神のさためてけれは君か代に二たひすめる堀川の水",
   "poems": [
    "1",
    "2"
   ]
  },
  {
   "id": "zoku-gunsho-chosho-sumodachi-shiika-0003",
   "pid": "nao-734213",
   "pages": [
    4
   ],
   "text": "左匡衡左述懐身老五華風月席家伝十葉帝王師三番右梅近香入窓嘉言梅かゝを夜半の嵐に吹ためて我ねやの戸をあくる待けり左紅梅仙臼風生空歎雪治鱸火暖未揚煙四番右従冥入於冥泉式部暗より暗き道にそ入ぬへき遥にてらせ山のはのつき左不軽品以言真如珠上塵獣礼忍辱衣中石結縁五番右松声入夜琴斉宮女御ことの音にみねの松風かよふらしいつれのをよりしらへそめけん左落花渡水舞儀同三司雪膚路湿寛裳重風力橋高錦袖明六番右関路暁月範永有明の月も清水にやとりけりこよひはこえしあふさらの関",
   "poems": [
    "3",
    "4",
    "5",
    "6"
   ]
  },
  {
   "id": "zoku-gunsho-chosho-sumodachi-shiika-0004",
   "pid": "nao-734213",
   "pages": [
    5
   ],
   "text": "左月前多遠情孝道遊子不帰郷国夢明妃有涙塞垣秋七番右好忠我かせこかきまさぬよひの秋かせはこぬ人よりもうらめしきかな立擣衣年々別思驚秋雁夜々幽声到暁難八番右小大君岩橋の夜の契もたへぬへしあくわひしきかつらきの神左新嘗会五郎舞儀同三司繍帳粧成燈照曜金楼宴羈月徘徊九番右嘉言君か代は千世に一たひゐるちりのしら雲かゝる山となるまて左聴講会斉名秦茶早苅三章日殷綱綾張一面風十番長能右鷹狩長能霰降かりはのみのゝすり衣ぬれぬ宿かす人しなけれは",
   "poems": [
    "7",
    "8",
    "9",
    "10"
   ]
  },
  {
   "id": "zoku-gunsho-chosho-sumodachi-shiika-0005",
   "pid": "nao-734213",
   "pages": [
    6
   ],
   "text": "左雪飛千里外為時胡塞噺花遥去馬巴山歌月遠行人十一番右堀河右大臣いかなれはおなし時雨に紅葉するはゝその杜のうすくこから左冬日法音寺匡衡華イ紅葉嵐深窓暗雨蒼葦日暮鬢寒霜十二番右伊勢大輔いにしへのならのみやこの八重桜けふ九重ににほひぬるかな左菊花照宮殿以言漢栢弥奢香送暮尭弟非仰色来秋十三番兼澄右春の内にちりつもるともきよめせし花にせかなく宿といはせん左秋葉逐日落中書王逐夜光多異苑月毎朝声少潰林風十四番右恵慶法師八重葎しけれる宿のさひしきに人こそ見えね秋は来ゆり",
   "poems": [
    "11",
    "12",
    "13",
    "14"
   ]
  },
  {
   "id": "zoku-gunsho-chosho-sumodachi-shiika-0006",
   "pid": "nao-734213",
   "pages": [
    7
   ],
   "text": "左開中日月長以言陶門跡絶春朝雨燕寝色裏秋夜霜十五番右相模見わたせは波のしからみかけてけりうの花さける玉川の里左秋夜雨斉名蒹葭洲裏孤舟夢楡営頭万里情十六番右七夕堀河右大臣たなはたの雲の衣をひきかさねかへさてぬるやこよひなるらん左賓鴻是故人後中書王雲衣范叔羇中贈風櫓浦潮浪上舟十七番右住吉松安法法師あまくたるあら人かみの相生をおもへば久しすみよしき松左遠栖霞寺儀同三司庭松百尺歴年老山月幾曲仍旧圃十八番右好忠雪消はえくのわかなも摘へきに春さへ消ぬ深山への里は",
   "poems": [
    "15",
    "16",
    "17",
    "18"
   ]
  },
  {
   "id": "zoku-gunsho-chosho-sumodachi-shiika-0007",
   "pid": "nao-734213",
   "pages": [
    8
   ],
   "text": "左宇治別業斉名野酌卯時来葉露山畦甲日稲花風十九番掖右忠慶法師あさち原たましく葛の浦風にうらかなしかる秋は来にけり五秋声夕在山以言衆籟暁興林頭老群源夕叩谷心寒廿番最手実方右郭公さつきやみ久羅橋山の郭公おほつかなくも鳴渡るかな左八月十五夜後中書王昼夜和同迷漏刻乾坤洞朗照玄黄長承二年八月廿八日博陸前大相国御教書併可撰進給詩歌事以詩為左以歌為右可被撰進秀逸也撰進之意可令模相撲立給歟周請和語事知其気味之人当時死其人仍所仰遣也者予忽奉教命不能固辞相扶霧露渉猟和漠然而大ニ耄已及同類難求深思不遑遺恨相配之同年十一一月十八日依恐淹留愍以進覧之同廿日御教ニ",
   "poems": [
    "19",
    "20"
   ]
  },
  {
   "id": "zoku-gunsho-chosho-sumodachi-shiika-0008",
   "pid": "nao-734213",
   "pages": [
    9
   ],
   "text": "旨云所令厭給和漢両篇金玉有聲詩慣白氏之一躰歌伝赤人之六義就中和歌為幹不慙古人無双当世深染心肝所感思食也者也者是者去九月昼日献詩歌御返事也事也同日重被命云相撲詩歌鳩集之体神也又ハ神也貴下者文道美華久挙春華之香気深知秋実之気味撰定之趣已叶御察感気無極者記三已上三ケ度御教書中書予一揖并拝納置侍価非啻施当侍即重基奉書時之名誉兼又為身後之美談也仍記録微志以貽後昆只恐有詩歌之幽霊遺恨風月之時輩反脣耳保延二年十一月八日以前左金吾自筆本書写畢延文元年五月九日依源高秀所望以入道三品後成卿自筆本為秀朝臣相伝書写訖于時文亀四年三月十六日以或証本書写前因幡守三善朝臣",
   "poems": []
  }
 ],
 "poems": [
  {
   "seq": "1",
   "text": "春きてそ人もとひける山さとは花こそ宿のあるしなりけれ",
   "kana": "",
   "speaker": "四條大納言",
   "page": 3,
   "pid": "nao-734213",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "右",
   "dai": "山家春"
  },
  {
   "seq": "2",
   "text": "みな神のさためてけれは君か代に二たひすめる堀川の水",
   "kana": "",
   "speaker": "",
   "page": 3,
   "pid": "nao-734213",
   "form": "短歌",
   "genre": "",
   "ban": "二",
   "side": "",
   "dai": ""
  },
  {
   "seq": "3",
   "text": "梅かゝを夜半の嵐に吹ためて我ねやの戸をあくる待けり",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-734213",
   "form": "短歌",
   "genre": "",
   "ban": "三",
   "side": "",
   "dai": ""
  },
  {
   "seq": "4",
   "text": "暗より暗き道にそ入ぬへき遥にてらせ山のはのつき",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-734213",
   "form": "短歌",
   "genre": "",
   "ban": "四",
   "side": "",
   "dai": ""
  },
  {
   "seq": "5",
   "text": "ことの音にみねの松風かよふらしいつれのをよりしらへそめけん",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-734213",
   "form": "短歌",
   "genre": "",
   "ban": "五",
   "side": "",
   "dai": ""
  },
  {
   "seq": "6",
   "text": "有明の月も清水にやとりけりこよひはこえしあふさらの関",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-734213",
   "form": "短歌",
   "genre": "",
   "ban": "六",
   "side": "右",
   "dai": "関路暁月範永"
  },
  {
   "seq": "7",
   "text": "我かせこかきまさぬよひの秋かせはこぬ人よりもうらめしきかな",
   "kana": "",
   "speaker": "好忠",
   "page": 5,
   "pid": "nao-734213",
   "form": "短歌",
   "genre": "",
   "ban": "七",
   "side": "右",
   "dai": ""
  },
  {
   "seq": "8",
   "text": "岩橋の夜の契もたへぬへしあくわひしきかつらきの神",
   "kana": "",
   "speaker": "小大君",
   "page": 5,
   "pid": "nao-734213",
   "form": "短歌",
   "genre": "",
   "ban": "八",
   "side": "右",
   "dai": ""
  },
  {
   "seq": "9",
   "text": "君か代は千世に一たひゐるちりのしら雲かゝる山となるまて",
   "kana": "",
   "speaker": "嘉言",
   "page": 5,
   "pid": "nao-734213",
   "form": "短歌",
   "genre": "",
   "ban": "九",
   "side": "右",
   "dai": ""
  },
  {
   "seq": "10",
   "text": "霰降かりはのみのゝすり衣ぬれぬ宿かす人しなけれは",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-734213",
   "form": "短歌",
   "genre": "",
   "ban": "十",
   "side": "右",
   "dai": "鷹狩長能"
  },
  {
   "seq": "11",
   "text": "いかなれはおなし時雨に紅葉するはゝその杜のうすくこから",
   "kana": "",
   "speaker": "堀河右大臣",
   "page": 6,
   "pid": "nao-734213",
   "form": "短歌",
   "genre": "",
   "ban": "十一",
   "side": "右",
   "dai": ""
  },
  {
   "seq": "12",
   "text": "いにしへのならのみやこの八重桜けふ九重ににほひぬるかな",
   "kana": "",
   "speaker": "伊勢大輔",
   "page": 6,
   "pid": "nao-734213",
   "form": "短歌",
   "genre": "",
   "ban": "十二",
   "side": "右",
   "dai": ""
  },
  {
   "seq": "13",
   "text": "春の内にちりつもるともきよめせし花にせかなく宿といはせん",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nao-734213",
   "form": "短歌",
   "genre": "",
   "ban": "十三",
   "side": "右",
   "dai": ""
  },
  {
   "seq": "14",
   "text": "八重葎しけれる宿のさひしきに人こそ見えね秋は来ゆり",
   "kana": "",
   "speaker": "恵慶法師",
   "page": 6,
   "pid": "nao-734213",
   "form": "短歌",
   "genre": "",
   "ban": "十四",
   "side": "右",
   "dai": ""
  },
  {
   "seq": "15",
   "text": "見わたせは波のしからみかけてけりうの花さける玉川の里",
   "kana": "",
   "speaker": "相模",
   "page": 7,
   "pid": "nao-734213",
   "form": "短歌",
   "genre": "",
   "ban": "十五",
   "side": "右",
   "dai": ""
  },
  {
   "seq": "16",
   "text": "たなはたの雲の衣をひきかさねかへさてぬるやこよひなるらん",
   "kana": "",
   "speaker": "堀河右大臣",
   "page": 7,
   "pid": "nao-734213",
   "form": "短歌",
   "genre": "",
   "ban": "十六",
   "side": "右",
   "dai": "七夕"
  },
  {
   "seq": "17",
   "text": "あまくたるあら人かみの相生をおもへば久しすみよしき松",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nao-734213",
   "form": "短歌",
   "genre": "",
   "ban": "十七",
   "side": "",
   "dai": ""
  },
  {
   "seq": "18",
   "text": "雪消はえくのわかなも摘へきに春さへ消ぬ深山への里は",
   "kana": "",
   "speaker": "好忠",
   "page": 7,
   "pid": "nao-734213",
   "form": "短歌",
   "genre": "",
   "ban": "十八",
   "side": "右",
   "dai": ""
  },
  {
   "seq": "19",
   "text": "あさち原たましく葛の浦風にうらかなしかる秋は来にけり",
   "kana": "",
   "speaker": "忠慶法師",
   "page": 8,
   "pid": "nao-734213",
   "form": "短歌",
   "genre": "",
   "ban": "十九",
   "side": "右",
   "dai": ""
  },
  {
   "seq": "20",
   "text": "さつきやみ久羅橋山の郭公おほつかなくも鳴渡るかな",
   "kana": "",
   "speaker": "",
   "page": 8,
   "pid": "nao-734213",
   "form": "短歌",
   "genre": "",
   "ban": "廿",
   "side": "右",
   "dai": "郭公"
  }
 ],
